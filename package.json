{
  "name": "lineup-lab",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "vite",
    "design:shots": "node scripts/design-shots.mjs",
    "prebuild": "npm run copy-scan",
    "build": "tsc -b && vite build",
    "build:ios": "VITE_API_BASE_URL=\"${VITE_API_BASE_URL:-https://oddsgods.net}\" npm run build && npx cap sync ios",
    "ios:sim": "npm run build:ios && xcodebuild -project ios/App/App.xcodeproj -scheme App -sdk iphonesimulator -configuration Debug -destination 'generic/platform=iOS Simulator' -derivedDataPath /tmp/oddsgods-dd CODE_SIGNING_ALLOWED=NO build >/dev/null && xcrun simctl install booted /tmp/oddsgods-dd/Build/Products/Debug-iphonesimulator/App.app && xcrun simctl terminate booted net.oddsgods.app 2>/dev/null; xcrun simctl launch booted net.oddsgods.app",
    "brand-check": "node scripts/brand-check.mjs",
    "copy-scan": "node test/copyScan.test.mjs",
    "lint": "node scripts/lint.mjs && npm run copy-scan",
    "preview": "vite preview",
    "server": "node server/index.js",
    "start": "node server/index.js",
    "test": "node --experimental-strip-types --test test/*.test.mjs"
  },
  "dependencies": {
    "@capacitor/cli": "^8.5.0",
    "@capacitor/core": "^8.5.0",
    "@capacitor/ios": "^8.5.0",
    "@supabase/supabase-js": "^2.108.1",
    "express": "^5.2.1",
    "multer": "^2.1.1",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-router-dom": "^7.13.2",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@eslint/js": "9.39.4",
    "@types/node": "^24.12.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "5.1.1",
    "eslint": "9.39.4",
    "eslint-plugin-react-hooks": "5.2.0",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.4.0",
    "playwright": "^1.61.1",
    "typescript": "5.8.3",
    "typescript-eslint": "8.63.0",
    "vite": "7.2.7"
  }
}
