# Copy to `.env` if you need any of these. Most people never will.
#
#   cp .env.example .env
#
# `.env` is gitignored. Never commit it.
#
# NOTHING IN THIS FILE IS REQUIRED TO RUN THE APP.
# Every value below either has a working default in committed source, or the
# feature behind it degrades to a no-op when the value is missing. A bare
# clone runs: `npm install`, `npm run server`, `npm run dev`.
#
# In particular, the design surfaces (/design/matchup-live, /design/market,
# /design/board-row) are client-side fixtures and need none of this.


# ── Supabase ──────────────────────────────────────────────────────────────
# server/services/supabaseAdmin.js already falls back to the project URL and
# the publishable anon key, both in committed source. Set these only to point
# at a different Supabase project.
# SUPABASE_URL=
# SUPABASE_ANON_KEY=

# Optional. Unset is a supported state, including in production.
# It gates exactly three things, each of which no-ops without it:
#   - loadConsensus() in server/projections/adjusted.js returns {}, so pricing
#     runs on the raw model with no admin agreement tilt
#   - getAgreementRows() in server/routes/projections.js returns []
#   - the scouting harvest returns 503 (its UI was removed anyway)
# Nothing else reads it. If you are not editing agreement scores, skip it.
# SUPABASE_SERVICE_ROLE_KEY=


# ── Local conveniences ────────────────────────────────────────────────────

# Guards the projections admin. Falls back to a dev password when unset.
# ADMIN_PASSWORD=

# API server port. Defaults to 8799.
# PORT=


# ── Off unless configured ─────────────────────────────────────────────────

# ESPN league connect via the login worker.
# ESPN_LOGIN_ENABLED=
# ESPN_LOGIN_WORKER_URL=
# ESPN_CRED_KEY=

# Narrated trade rationale. The endpoint still returns its grounded structured
# rationale without these; they only add the prose layer.
# TRADE_RATIONALE_API_KEY=
# TRADE_RATIONALE_MODEL=
# OPENAI_API_KEY=
